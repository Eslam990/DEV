# Managed MySQL / Drizzle
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Manus managed OAuth (filled by the project runtime when available)
MANUS_OAUTH_PORTAL_URL=https://auth.example.invalid
MANUS_OAUTH_API_URL=https://auth.example.invalid
MANUS_PROJECT_ID=your-project-id
EXPO_PUBLIC_OAUTH_PORTAL_URL=
