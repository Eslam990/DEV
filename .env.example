EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_API_BASE_URL=

# Manus Object Storage runtime credentials; keep server-side only
BUILT_IN_FORGE_API_URL=https://forge.example.invalid
BUILT_IN_FORGE_API_KEY=replace-on-server-only

# Optional publication/runtime values
EXPO_WEB_PREVIEW_URL=
EXPO_PACKAGER_PROXY_URL=
